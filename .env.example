# Zentro API — environment
#
# Copy to .env. The defaults below work as-is for local development.
#
# Configuration is validated at boot: a missing or malformed value stops the app with a
# clear error instead of falling back to something insecure. If startup complains about a
# key, add it here rather than removing the check.
#
# .env is gitignored. Never commit real secrets. Never put a production value in this file.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Comma-separated allowlist. Must be exact origins — a wildcard is incompatible with
# cookie-based auth, which is deliberate.
CORS_ORIGINS=http://localhost:4200

# ─── Database ─────────────────────────────────────────────────────────────────
# These are also read by docker-compose to initialize the Postgres container.
# Changing them after the volume exists has no effect — see docs/runbooks/local-dev.md.
DB_HOST=localhost
DB_PORT=5432
DB_USER=zentro
DB_PASSWORD=zentro_local_password
DB_NAME=zentro
DB_SSL=false

# Free-tier Postgres allows very few connections. Keep this low.
DB_POOL_MAX=10

# Never set this to true. Schema changes go through migrations — see ADR-0001.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate real values with: openssl rand -base64 48
# The two secrets must differ — an access token must never be usable as a refresh token.
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_before_deploying
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_before_deploying
JWT_REFRESH_TTL=30d

# Cookie carrying the refresh token. Secure must be true anywhere served over HTTPS.
REFRESH_COOKIE_NAME=zentro_rt
REFRESH_COOKIE_DOMAIN=localhost
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# argon2id. Raise memory/time as hardware allows; lower values here keep tests fast.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# From https://console.cloud.google.com/apis/credentials — free.
# Leave blank to disable Google sign-in locally; the app still boots.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Used to build links in verification, reset and invite emails.
WEB_APP_URL=http://localhost:4200

# ─── Email ────────────────────────────────────────────────────────────────────
# console  — print emails to stdout (default for local development, no account needed)
# resend   — Resend API (free tier: 3k/month)
MAIL_DRIVER=console
MAIL_FROM="Zentro <no-reply@zentro.app>"
RESEND_API_KEY=

# ─── Object storage (receipt images) ──────────────────────────────────────────
# local   — write to ./storage on disk, no account needed
# s3      — any S3-compatible service (Cloudflare R2 free tier: 10GB)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760
SIGNED_URL_TTL_SECONDS=300

# ─── FX rates ─────────────────────────────────────────────────────────────────
# Rates are snapshotted onto each expense at creation — see ADR-0006.
# The default provider needs no API key.
FX_PROVIDER=frankfurter
FX_API_KEY=
FX_BASE_CURRENCY=USD

# ─── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# Optional. Blank disables error reporting entirely.
SENTRY_DSN=
