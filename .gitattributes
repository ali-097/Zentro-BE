# Normalize line endings to LF everywhere, in the repo and in the working tree.
#
# Without this, a Windows checkout produces CRLF files that Prettier flags as errors on
# every single line, so CI fails for everyone on Windows and passes for everyone else.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated. Collapsed in diffs, and excluded from language statistics.
package-lock.json -diff linguist-generated=true
openapi.json -diff linguist-generated=true
