{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npm run test:cov)",
      "Bash(npm run test:e2e)",
      "Bash(npm run migration:show)",
      "Bash(npm run migration:generate -- *)",
      "Bash(npm ci)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs*)",
      "Bash(curl http://localhost:3000/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./storage/**)",
      "Bash(git push --force*)",
      "Bash(docker compose down -v*)"
    ]
  }
}
