# Development image, used by `docker compose --profile full up`.
#
# Unlike Dockerfile, this keeps dev dependencies and the TypeScript sources so watch mode
# works. Source is bind-mounted by compose, so edits on the host reload inside the container.
#
# Never deploy this image.

FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

CMD ["npm", "run", "start:dev"]
